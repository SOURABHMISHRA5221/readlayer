# Copy to apps/api/.env for local runs. Never commit .env.
ENV=dev
LOG_LEVEL=INFO

GCP_PROJECT=readlayer-sourabh-26
# "global" serves every model below; Gemma MaaS is only on the global endpoint.
VERTEX_LOCATION=global

# LiteLLM model strings (checked live on Vertex 2026-10-04).
MODEL_FAST=vertex_ai/gemini-3.5-flash-lite
MODEL_QUALITY=vertex_ai/gemini-3.8-flash
MODEL_FALLBACK=vertex_ai/google/gemma-4-26b-a4b-it-maas
# Faithfulness judge for explanations (task verify). Empty = MODEL_QUALITY.
MODEL_JUDGE=
# Embeddings (checked live 2026-10-04; served on the global endpoint). No fallback model.
MODEL_EMBED=vertex_ai/gemini-embedding-001
EMBED_DIM=256

# Concept graph loaded at startup (gs:// URI or local path; empty = no graph).
CONCEPTS_URI=gs://readlayer-sourabh-26-graph/concepts.json
# Entity-linking cosine threshold, calibrated by scripts/build_concepts.py.
LINK_THRESHOLD=0.865
DEDUPE_THRESHOLD=0.88

LLM_DAILY_BUDGET_USD=8
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2
# JSON map of model -> [input_usd_per_token, output_usd_per_token] for models LiteLLM can't price.
MODEL_PRICE_OVERRIDES={}

# Salt for uid_hash in logs. Any random string locally; Secret Manager in prod.
UID_HASH_SALT=change-me

# Recommendations: web search providers (server-side only; Secret Manager in prod).
TAVILY_API_KEY=
YOUTUBE_API_KEY=
SEARCH_DAILY_CAP=300
YOUTUBE_SEARCH_DAILY_CAP=90
INGEST_DAILY_CAP=20
# Anonymous (demo) readers: per-reader and shared daily caps on new URLs and web searches.
ANON_INGEST_DAILY_CAP=3
ANON_GLOBAL_INGEST_DAILY_CAP=30
ANON_SEARCH_DAILY_CAP=100

# Browser origins allowed by CORS (comma-separated). Locally Vite proxies /v1, so none needed.
CORS_ORIGINS=

# Local dev only, for curl and scripts: a request without an Authorization header acts as a
# fixed anonymous dev uid. Refused on Cloud Run (K_SERVICE) or with ENV=prod. `make dev` doesn't
# set it; the web app signs in with Firebase for real.
# DEV_AUTH_BYPASS=true
