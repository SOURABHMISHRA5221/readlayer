# Production build (`pnpm --filter extension build`): public values only. The Firebase web API
# key isn't here; the web app's Connect page hands it to the extension with the session.
VITE_API_BASE=https://readlayer-api-d2sfihz3za-el.a.run.app
# Decision 62: the web app lives at glossreader.web.app; the old address keeps working, so the
# extension connects from both (the session remembers which, and opens the web reader there).
VITE_WEB_BASE=https://glossreader.web.app
VITE_WEB_ORIGINS=https://glossreader.web.app,https://glossreader.firebaseapp.com,https://readlayer-sourabh-26.web.app,https://readlayer-sourabh-26.firebaseapp.com
