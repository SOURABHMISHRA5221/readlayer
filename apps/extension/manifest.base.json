{
  "manifest_version": 3,
  "name": "ReadLayer",
  "version": "0.8.0",
  "description": "Notes on the news you're likely to miss, explained your way. Runs only when you click it.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ReadLayer",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Open ReadLayer"
    }
  },
  "externally_connectable": {
    "matches": []
  }
}
