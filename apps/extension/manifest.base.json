{
  "manifest_version": 3,
  "name": "Gloss",
  "version": "0.8.2",
  "description": "Gloss notes the ideas in a news article you're likely to miss, explained your way. Runs only when you click it.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Gloss",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/margo-128.png",
      "32": "icons/margo-128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Open Gloss"
    }
  },
  "externally_connectable": {
    "matches": []
  },
  "icons": {
    "16": "icons/margo-128.png",
    "48": "icons/margo-128.png",
    "128": "icons/margo-128.png"
  }
}
